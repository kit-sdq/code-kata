    {
      "id": "claim_98be9c3b52bc42adace8ebde7b266882",
      "statement": "`vite.config.ts` sets `base: './'` so Vite emits relative asset URLs (`./assets/...`) instead of absolute root-anchored ones. This is required for GitHub Pages project-site deployment at `https://<user>.github.io/<repo>/` (a sub-path), and makes the same `dist/` portable across repo names.",
      "evidence": [
        {
          "resource": "repo://docs/CONTRACT.md#L6-L7",
          "version": "repo-lines-v1:sha256:cc080a9a8c303b0880bcd876401e0d7ae63405d497e08f4177941075da5d9c20:"
