    {
      "id": "claim_334572a15e07443abc2188b5991cba45",
      "statement": "`npm run build` is the composition `tsc --noEmit && vite build`: `tsc --noEmit` is a pure type-check gate that emits nothing and aborts the build on failure, then `vite build` bundles the app into `dist/`.",
      "evidence": [
        {
          "resource": "repo://package.json#L8-L12",
