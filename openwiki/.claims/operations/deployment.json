    {
      "id": "claim_1bf6419699a642dc80c927171ab85752",
      "statement": "The CheerpJ runtime is loaded live from Leaning Technologies' CDN via `importScripts('https://cjrtnc.leaningtech.com/4.3/loader.js')` at the top of `public/sandbox-worker.js`, then `cheerpjInit()` is called lazily on first use. The loader URL is pinned to major version 4.3 and is NOT bundled/vendored.",
      "evidence": [
        {
          "resource": "repo://public/sandbox-worker.js#L1-L14",
          "version": "repo-lines-v1:sha256:cbc6ce6f40e4868838fe529d8ec832350d31aa4afd7a0ec83ad66aabefcc582f:"
