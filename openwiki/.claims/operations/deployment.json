    {
      "id": "claim_367bf80a45c34263a866889fd035acf1",
      "statement": "`index.html` is Vite's single entry point; its `<link rel=\"stylesheet\" href=\"/src/styles.css\">` and module `<script src=\"/src/main.ts\">` are the two roots of the bundle graph, and Vite rewrites these absolute `/src/...` references to hashed asset URLs during build.",
      "evidence": [
        {
          "resource": "repo://index.html#L1-L16",
