    {
      "id": "claim_d4e8dcba0dff4963943fee0c33ed371d",
      "statement": "Katas are `katas/*.md` files discovered at build time by `src/kata/load.ts` via Vite's `import.meta.glob` (eager, raw). There is no manifest; adding a kata is dropping a `.md` file and pushing to `main` so the workflow rebuilds. There is no way to add a kata without a rebuild — this is a static site, not a CMS.",
      "evidence": [
        {
          "resource": "repo://README.md#L34-L45",
          "version": "repo-lines-v1:sha256:a709a97b57965610d309f7a8f15629e08a6dda91de5f5dd0c98133938b877dc6:"
