    {
      "id": "claim_25b33bf59e804a5d813780e40150f9c0",
      "statement": "scalarLiteral renders a non-array JavaValue as a Java literal with type-specific suffixes/escaping: long gets the L suffix, float the f suffix, int is bare, double gets .0 appended when the textual form lacks a . or e/E, char is escaped via charJavaLiteral (handling quote, backslash, newline, tab, printable ASCII, else \\uXXXX), and string is escaped via escapeJavaChars (escaping backslash, quote, \\n, \\r, \\t, and any char outside 0x20-0x7e as \\uXXXX).",
      "evidence": [
        {
          "resource": "repo://src/runner/harness.ts#L22-L52",
