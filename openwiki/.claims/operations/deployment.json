        }
      ]
    },
    {
      "id": "claim_5901e22a5a294b5b99643bd27303d9f7",
      "statement": "The first code-task run per browser session is slow because CheerpJ's JVM-in-WASM runtime is fetched from the CDN and JIT/AOT-warmed on first use (then browser-cached). The runner budgets 90 s (`INIT_BUDGET_MS = 90_000`) for loading+compiling and surfaces `loading`/`compiling` phases to the UI; the per-run timeout (`timeoutMs`, default 5000) only starts once the sandbox reports the `running` phase.",
      "evidence": [
        {
          "resource": "repo://src/runner/runner.ts#L18-L20",
          "version": "repo-lines-v1:sha256:1114e9d03bfc0a2f50ae445b2fd4aa5d87a23e75ed299aa6b13b3cba9b1737f4:"
        },
