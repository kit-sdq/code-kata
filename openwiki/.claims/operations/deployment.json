    {
      "id": "claim_1d326494290c4d8e82a5492de10f9ed1",
      "statement": "The deploy workflow triggers on push to `main` and `workflow_dispatch`. The `build` job (ubuntu-latest, Node 22, `cache: npm`) runs `npm ci`, `npm test`, `npm run build`, then `upload-pages-artifact@v3` with `path: dist`. The `deploy` job (`needs: build`) runs `deploy-pages@v4` in the `github-pages` environment. A `pages` concurrency group with `cancel-in-progress: false` serializes deploys.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/deploy.yml#L1-L44",
          "version": "repo-lines-v1:sha256:ed2f351a30e6a91ccee9addee2b4f2e0ff81652ea596ca097e6ed0137c917698:"
        }
      ]
    },
    {
      "id": "claim_f3706855a4c149a2bdfd948e44c854b5",
      "statement": "The deploy workflow declares `permissions: contents: read, pages: write, id-token: write`; the `id-token: write` is required for the OIDC-based `deploy-pages` action, and `pages: write` is needed to publish.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/deploy.yml#L36-L39",
          "version": "repo-lines-v1:sha256:0720f4441b96eea2a0bd281960cc650809401a90613e0cd0191a985101993d19:"
